    "xcodebuild",
    "app-store",
    "app-store-connect",
    "react-native",
    "expo",
    "ios-build",
    "ipa",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zibs/react-native-paperplane.git"
  },
  "bugs": {
    "url": "https://github.com/zibs/react-native-paperplane/issues"
  },
